{
  "name": "mcp-gate",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "core:dev": "pnpm --filter @mcp-gate/core dev",
    "core:smoke": "pnpm --filter @mcp-gate/core smoke",
    "desktop:dev": "pnpm --filter @mcp-gate/desktop tauri dev",
    "desktop:web": "pnpm --filter @mcp-gate/desktop dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "core:management-smoke": "pnpm --filter @mcp-gate/core management:smoke",
    "test": "pnpm --filter @mcp-gate/core test",
    "core:gateway-smoke": "pnpm --filter @mcp-gate/core gateway:smoke",
    "desktop:sidecar:prepare": "node scripts/prepare-core-sidecar.mjs",
    "desktop:bundle": "pnpm desktop:sidecar:prepare && pnpm --filter @mcp-gate/desktop tauri build --config src-tauri/tauri.production.conf.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@github/keytar"
    ]
  }
}\n